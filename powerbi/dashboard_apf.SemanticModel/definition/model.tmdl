model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_QueryOrder = ["marocains_controles","mre_controles","touristes_pa","touristes_pm_pt"]

annotation PBI_ProTooling = ["DevMode"]

ref table marocains_controles
ref table mre_controles
ref table touristes_pa
ref table touristes_pm_pt

ref cultureInfo en-US

